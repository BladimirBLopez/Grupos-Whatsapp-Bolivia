{
  "functions": {
    "api/grupos.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/login.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/categorias.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/sync-imagenes.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/preview.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/solicitudes.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/grupos",
      "destination": "/api/grupos.js"
    },
    {
      "source": "/api/login",
      "destination": "/api/login.js"
    },
    {
      "source": "/api/categorias",
      "destination": "/api/categorias.js"
    },
    {
      "source": "/api/sync-imagenes",
      "destination": "/api/sync-imagenes.js"
    },
    {
      "source": "/api/preview",
      "destination": "/api/preview.js"
    },
    {
      "source": "/api/solicitudes",
      "destination": "/api/solicitudes.js"
    }
  ],
  "headers": [
    {
      "source": "/api/categorias",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/api/grupos",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=30, stale-while-revalidate=120"
        }
      ]
    }
  ]
}